[Unit]
Description=Sing-Box Universal Telegram Management Bot
After=network.target sing-box.service nginx.service xray.service

[Service]
Type=simple
User=incy-bot
Group=incy-bot
WorkingDirectory=/opt/incy-bot
ExecStart=/opt/incy-bot/venv/bin/python3 /opt/incy-bot/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/incy-bot/.env

# Security Hardening & Sandboxing
# Note: NoNewPrivileges, CapabilityBoundingSet, and RestrictSUIDSGID must allow sudo
# to execute the strictly whitelisted root helper /usr/local/bin/singbox-control via /etc/sudoers.d/incy-bot.
# Directives that implicitly enforce kernel PR_SET_NO_NEW_PRIVS in systemd.exec
# (e.g., ProtectKernelTunables, ProtectKernelModules, RestrictAddressFamilies, LockPersonality)
# must remain omitted so setuid sudo functions properly.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ReadWritePaths=/opt/incy-bot /var/www /etc/sing-box /etc/xray /tmp

[Install]
WantedBy=multi-user.target
