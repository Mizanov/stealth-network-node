# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Authorized Admin Telegram IDs (comma-separated, find via @userinfobot)
TELEGRAM_ADMIN_IDS=123456789

# Optional: Obfuscated URL paths (auto-generated with random hex if empty)
SUBS_PATH=
VLESS_PATH=
TROJAN_PATH=
RULESET_PATH=
