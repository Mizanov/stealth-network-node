{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    },
    {
      "tag": "http-in",
      "port": 10809,
      "listen": "127.0.0.1",
      "protocol": "http"
    }
  ],
  "outbounds": [
    {
      "tag": "proxy-masque",
      "protocol": "masque",
      "settings": {
        "address": "{{DOMAIN}}",
        "port": {{MASQUE_PORT}}
      },
      "streamSettings": {
        "network": "masque",
        "security": "tls",
        "tlsSettings": {
          "serverName": "{{DOMAIN}}"
        },
        "masqueSettings": {
          "headers": {
            "Authorization": "Basic {{USER_AUTH_BASE64}}"
          }
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ]
}
